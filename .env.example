# Server-side only. Never use a VITE_ or NEXT_PUBLIC_ prefix for a secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_INTERVAL_MS=15000
# Match these ceilings to the actual free-tier quotas shown in Google AI Studio.
GEMINI_RPM_LIMIT=8
GEMINI_RPD_LIMIT=150
# Optional private owner key for the simulated temperature scan. Blank clones
# show "Arduino not found". Never commit a real key or expose it to the browser.
ARDUINO_DEMO_KEY=
